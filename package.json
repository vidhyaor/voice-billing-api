{
  "name": "voice-billing-api",
  "version": "1.0.0",
  "description": "Production-ready SaaS Voice Billing API for Hardware, Electrical, Plumbing and Building Material Shops",
  "main": "dist/server.js",
  "scripts": {
    "dev": "APP_ENV=local tsx watch src/server.ts",
    "dev:development": "APP_ENV=development tsx watch src/server.ts",
    "build": "tsc",
    "start": "APP_ENV=local NODE_ENV=production node dist/server.js",
    "start:development": "APP_ENV=development NODE_ENV=production node dist/server.js",
    "start:production": "APP_ENV=production NODE_ENV=production node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/with-env.cjs prisma migrate dev",
    "prisma:migrate:development": "APP_ENV=development node scripts/with-env.cjs prisma migrate dev",
    "prisma:migrate:production": "APP_ENV=production node scripts/with-env.cjs prisma migrate deploy",
    "prisma:studio": "node scripts/with-env.cjs prisma studio",
    "prisma:studio:development": "APP_ENV=development node scripts/with-env.cjs prisma studio",
    "lint": "tsc --noEmit",
    "test": "APP_ENV=local tsx --test src/**/*.test.ts"
  },
  "keywords": [
    "fastify",
    "prisma",
    "postgresql",
    "jwt",
    "voice-billing",
    "saas",
    "hardware-shop"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.4",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/client": "^6.3.1",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fuse.js": "^7.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.7",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
