APP_ENV=local
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voice_billing_local?schema=public"

JWT_SECRET=local-dev-secret-change-me-min-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3001

LOG_LEVEL=debug
SWAGGER_ENABLED=true
APP_NAME=Voice Billing API (Local)
APP_VERSION=1.0.0
