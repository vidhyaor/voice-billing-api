APP_ENV=production
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

JWT_SECRET=replace-with-a-long-random-production-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=https://your-frontend-domain.com

LOG_LEVEL=warn
SWAGGER_ENABLED=false
APP_NAME=Voice Billing API
APP_VERSION=1.0.0
